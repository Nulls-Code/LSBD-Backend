# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/lsbd_courier?schema=public

# JWT
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=your-jwt-expires-in
JWT_REFRESH_SECRET=your-refresh-secret-change-this-in-production
JWT_REFRESH_EXPIRES_IN=your-jwt-refresh-expires-in

# Bcrypt
BCRYPT_SALT_ROUNDS=your-bcrypt-salt-rounds

# CORS
CORS_ORIGIN=http://localhost:DEMO

# Rate Limiting
RATE_LIMIT_WINDOW_MS=any-number
RATE_LIMIT_MAX_REQUESTS=any-number
PUBLIC_RATE_LIMIT_WINDOW_MS=any-number
PUBLIC_RATE_LIMIT_MAX_REQUESTS=any-number
