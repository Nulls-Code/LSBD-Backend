model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?  @unique
  phone     String
  company   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  courierRequests CourierRequest[]

  @@index([phone])
  @@map("customers")
}
