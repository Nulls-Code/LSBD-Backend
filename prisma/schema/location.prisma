model Location {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  code      String   @unique
  city      String
  country   String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  originRequests       CourierRequest[] @relation("RequestOrigin")
  destinationRequests  CourierRequest[] @relation("RequestDestination")
  originShipments      Shipment[]      @relation("ShipmentOrigin")
  destinationShipments Shipment[]      @relation("ShipmentDestination")
  currentShipments     Shipment[]      @relation("ShipmentCurrentLocation")
  trackingUpdates      TrackingUpdate[]

  @@index([city])
  @@index([country])
  @@index([isActive])
  @@map("locations")
}
