model Shipment {
  id                    String         @id @default(uuid()) @db.Uuid
  trackingNumber        String         @unique @map("tracking_number")
  courierRequestId      String         @unique @map("courier_request_id") @db.Uuid
  senderName            String         @map("sender_name")
  senderPhone           String         @map("sender_phone")
  senderAddress         String         @map("sender_address")
  recipientName         String         @map("recipient_name")
  recipientPhone        String         @map("recipient_phone")
  recipientAddress      String         @map("recipient_address")
  originLocationId      String         @map("origin_location_id") @db.Uuid
  destinationLocationId String         @map("destination_location_id") @db.Uuid
  currentLocationId     String?        @map("current_location_id") @db.Uuid
  currentStatus         ShipmentStatus @default(PROCESSING) @map("current_status")
  packageDescription    String         @map("package_description")
  packageWeight         Decimal?       @map("package_weight") @db.Decimal(10, 2)
  weightUnit            WeightUnit?    @map("weight_unit")
  packageCount          Int            @default(1) @map("package_count")
  estimatedDeliveryDate DateTime?      @map("estimated_delivery_date")
  internalNotes         String?        @map("internal_notes")
  assignedToId          String?        @map("assigned_to_id") @db.Uuid
  createdById           String         @map("created_by_id") @db.Uuid
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  // Relations
  courierRequest      CourierRequest @relation(fields: [courierRequestId], references: [id])
  originLocation      Location       @relation("ShipmentOrigin", fields: [originLocationId], references: [id])
  destinationLocation Location       @relation("ShipmentDestination", fields: [destinationLocationId], references: [id])
  currentLocation     Location?      @relation("ShipmentCurrentLocation", fields: [currentLocationId], references: [id])
  assignedTo          User?          @relation("ShipmentAssignedTo", fields: [assignedToId], references: [id])
  createdBy           User           @relation("ShipmentCreatedBy", fields: [createdById], references: [id])
  trackingUpdates     TrackingUpdate[]

  @@index([currentStatus])
  @@index([currentStatus, createdAt(sort: Desc)])
  @@index([originLocationId])
  @@index([destinationLocationId])
  @@index([currentLocationId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([createdAt])
  @@map("shipments")
}
